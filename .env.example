# Sanity CMS — get these from https://www.sanity.io/manage (your project -> API)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Token with Editor/Write permissions — only needed for `npm run seed:sanity`
SANITY_API_WRITE_TOKEN=

# Contact form (Resend)
RESEND_API_KEY=

# Cloudflare Turnstile bot protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,jeffreygumbs.com,www.jeffreygumbs.com,jeffreygumbs.vercel.app
